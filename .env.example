# Public frontend configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-side only - NEVER expose these to GitHub Pages frontend
SUPABASE_SERVICE_ROLE_KEY=
SESSION_TOKEN_PEPPER=
# Comma-separated ORIGINS only (no /Game-Portal path). Required by the Edge Function.
ALLOWED_ORIGINS=https://ecleaire.github.io,http://127.0.0.1:4173

# Secure initial administrator bootstrap (server-side/setup only)
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# Google Drive server-side credentials/config (Supabase Edge Function secrets only)
# JSON for a dedicated service account. Do not put this in GitHub Actions or Pages.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_PENDING_FOLDER_ID=
GOOGLE_DRIVE_APPROVED_FOLDER_ID=
GOOGLE_DRIVE_REJECTED_FOLDER_ID=
